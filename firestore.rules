rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/pengguna/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || getUserData().role == 'ADMIN');
    }

    function isTeacher() {
      return isSignedIn() && (getUserData().role == 'guru' || getUserData().role == 'GURU' || getUserData().role == 'TEACHER');
    }

    function isHomeroomTeacher() {
      return isSignedIn() && (getUserData().role == 'wali_kelas' || getUserData().role == 'WALI_KELAS');
    }

    function isStudent() {
      return isSignedIn() && (getUserData().role == 'siswa' || getUserData().role == 'SISWA');
    }

    function isParent() {
      return isSignedIn() && (getUserData().role == 'orang_tua' || getUserData().role == 'ORANG_TUA');
    }

    // 1. Koleksi: sekolah
    match /sekolah/{sekolahId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Koleksi: pengguna
    match /pengguna/{userUid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userUid || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Koleksi: tahunAjaran, kelas, mapel, subMateri, periode
    match /tahunAjaran/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /kelas/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /mapel/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /subMateri/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /periode/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // 4. Koleksi: penugasan, keanggotaanKelas, relasiOrangTua
    match /penugasan/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /keanggotaanKelas/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /relasiOrangTua/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // 5. Koleksi: nilai & koreksiNilai
    match /nilai/{nilaiId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isTeacher() || isAdmin());
    }

    match /koreksiNilai/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isTeacher() || isAdmin());
    }

    // 6. Notifikasi & Sesi & Insight
    match /notifikasi/{id} { allow read, write: if isSignedIn(); }
    match /sesiPerangkat/{id} { allow read, write: if isSignedIn(); }
    match /insightCache/{id} { allow read, write: if isSignedIn(); }

    // Backward Compatibility for legacy collections
    match /penugasan/{penugasanId} { allow read: if isSignedIn(); allow write: if false; }
    match /scores/{scoreId} { allow read, write: if isSignedIn(); }
    match /users/{userId} { allow read, write: if isSignedIn(); }
    match /subjects/{subjectId} { allow read, write: if isSignedIn(); }
    match /topics/{topicId} { allow read, write: if isSignedIn(); }
    match /grades/{gradeId} { allow read, write: if isSignedIn(); }
    match /insights/{insightId} { allow read, write: if isSignedIn(); }
  }
}
