FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
GCLOUD_PROJECT=demo-kawansekolah
PORT=3000

# AI Provider Configuration (ollama | openrouter)
AI_PROVIDER=ollama
AI_FALLBACK=openrouter
AI_TIMEOUT_MS=90000

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=llama3.2:latest

# OpenRouter Cloud AI Configuration
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=isi_key_di_sini
OPENROUTER_API_KEY=isi_key_di_sini
OPENROUTER_MODEL=openai/gpt-4o-mini
